# Copier ce fichier en .env et remplir les valeurs.
# En production (Railway), définir ces variables dans l'onglet « Variables ».

# ── Django ─────────────────────────────────────────────
# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-secret-key-here
DEBUG=True
DJANGO_ENV=development            # "production" active HTTPS, cookies sécurisés, HSTS
ALLOWED_HOSTS=localhost,127.0.0.1
# Domaines autorisés pour les formulaires en production (avec https://)
# CSRF_TRUSTED_ORIGINS=https://mon-domaine.com
# Chemin secret de l'admin Django (par défaut admin/)
# ADMIN_URL=gestion-7f3k/

# ── Base de données ────────────────────────────────────
# Mettre "sqlite" pour tester en local sans PostgreSQL
# DB_ENGINE=sqlite
# Railway fournit DATABASE_URL automatiquement (prioritaire sur DB_*)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_NAME=portfolio_db
DB_USER=portfolio_user
DB_PASSWORD=your-password-here
DB_HOST=localhost
DB_PORT=5432

# ── Email (notification des messages de contact) ───────
# Sans EMAIL_HOST_USER / EMAIL_HOST_PASSWORD, les emails s'affichent dans la console.
# Gmail : utiliser un « mot de passe d'application », jamais le mot de passe du compte.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here
# Adresse qui reçoit les messages (par défaut EMAIL_HOST_USER)
# CONTACT_EMAIL=your-email@gmail.com

# ── Fichiers envoyés ───────────────────────────────────
# Sur Railway : monter un volume et y pointer MEDIA_ROOT (ex. /app/media)
# MEDIA_ROOT=/app/media
# MAX_UPLOAD_MB=10
